{
  "plugins": {
    "allow": [
      "memory-lancedb-pro"
    ],
    "enabled": true,
    "entries": {
      "memory-lancedb-pro": {
        "enabled": true,
        // OpenClaw 2026.5+ withholds conversation hooks (`agent_end`) from non-bundled plugins
        // without this grant; autoCapture smart extraction runs from `agent_end`.
        "hooks": {
          "allowConversationAccess": true
        },
        "config": {
          "embedding": {
            "provider": "openai-compatible",
            "apiKey": "ollama",
            "model": "nomic-embed-text",
            "baseURL": "http://127.0.0.1:11434/v1"
          },
          "dbPath": "__OPENCLAW_HOME__/memory/lancedb-pro",
          "enableManagementTools": false,
          "sessionStrategy": "none",
          "autoCapture": true,
          "autoRecall": false,
          "captureAssistant": false,
          "smartExtraction": true,
          // The vendored release counts only the user messages new since the previous turn, so a
          // gateway conversation (one new message per turn) never reaches the upstream default of 4.
          "extractMinMessages": 1,
          "llm": {
            "apiKey": "ollama",
            "model": "qwen2.5:7b",
            "baseURL": "http://127.0.0.1:11434/v1"
          },
          "selfImprovement": {
            "enabled": false
          },
          "retrieval": {
            "mode": "hybrid",
            "rerank": "none",
            "candidatePoolSize": 12,
            "minScore": 0.35,
            "hardMinScore": 0.4
          },
          "mdMirror": {
            "enabled": true,
            "dir": "__OPENCLAW_HOME__/memory/lancedb-pro-md"
          }
        }
      }
    },
    "load": {
      "paths": [
        "__PLUGIN_ROOT__/memory-lancedb-pro"
      ]
    },
    "slots": {
      "memory": "memory-lancedb-pro"
    }
  }
}
