{
  // OpenClaw 2026.8 removed the QMD memory backend; builtin memory is its only engine. The QMD
  // corpus is indexed through `memory.search.extraPaths`, the mapping `openclaw doctor --fix`
  // applies (docs/concepts/memory-builtin.md, "Migrating from QMD").
  "memory": {
    "citations": "auto",
    "search": {
      "extraPaths": [
        {
          "path": "__REPO_ROOT__/platform/docs",
          "pattern": "**/*.md"
        },
        {
          "path": "__REPO_ROOT__/platform/skills",
          "pattern": "**/*.md"
        },
        {
          "path": "__WORKSPACE_ROOT__",
          "pattern": "**/*.md"
        },
        {
          "path": "__UPSTREAM_REPO_ROOT__",
          "pattern": "**/*.md"
        },
        {
          "path": "__REPO_ROOT__",
          "pattern": "*.md"
        }
      ]
    }
  }
}
