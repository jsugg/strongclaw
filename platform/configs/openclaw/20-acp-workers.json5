{
  "agents": {
    "list": [
      {
        "agentDir": "~/.openclaw/agents/coder-acp-codex/agent",
        // OpenClaw 2026.6 made the first roster entry the default agent implicitly;
        // 2026.8 leaves an unmarked fleet without an owner for ambient work.
        "default": true,
        "id": "coder-acp-codex",
        "name": "Coder ACP Codex",
        "runtime": {
          "acp": {
            "agent": "coder-acp-codex",
            "backend": "acpx",
            "cwd": "__UPSTREAM_REPO_ROOT__",
            "mode": "persistent"
          },
          "type": "acp"
        },
        "sandbox": {
          "mode": "all",
          "scope": "agent",
          "workspaceAccess": "rw"
        },
        "subagents": {
          "allowAgents": [
            "reviewer-acp-claude",
            "reviewer"
          ]
        },
        "tools": {
          "allow": [
            "sessions_spawn",
            "sessions_list",
            "session_status",
            "memory_search",
            "memory_get"
          ],
          "deny": [
            "browser",
            "gateway",
            "cron",
            "nodes",
            "canvas",
            "send",
            "whatsapp",
            "telegram"
          ],
          "profile": "minimal"
        },
        "workspace": "__UPSTREAM_REPO_ROOT__"
      },
      {
        "agentDir": "~/.openclaw/agents/reviewer-acp-claude/agent",
        "id": "reviewer-acp-claude",
        "name": "Reviewer ACP Claude",
        "runtime": {
          "acp": {
            "agent": "reviewer-acp-claude",
            "backend": "acpx",
            "cwd": "__UPSTREAM_REPO_ROOT__",
            "mode": "persistent"
          },
          "type": "acp"
        },
        "sandbox": {
          "mode": "all",
          "scope": "agent",
          "workspaceAccess": "ro"
        },
        "tools": {
          "allow": [
            "sessions_list",
            "session_status",
            "memory_search",
            "memory_get"
          ],
          "deny": [
            "write",
            "edit",
            "apply_patch",
            "exec",
            "process",
            "browser",
            "gateway",
            "cron",
            "nodes",
            "canvas",
            "send",
            "whatsapp",
            "telegram"
          ],
          "profile": "minimal"
        },
        "workspace": "__UPSTREAM_REPO_ROOT__"
      },
      // The only unsandboxed agent. OpenClaw refuses ACP spawns from sandboxed sessions, so ACP
      // workers start from here, and only through the operator.admin `/acp spawn` command.
      // `allow` names a tool that `deny: ["*"]` removes: with no callable tools left, OpenClaw
      // stops every ordinary turn before it reaches the model. It is never the default agent,
      // never a binding target, and no agent may spawn it (platform/docs/ACP_WORKERS.md).
      {
        "agentDir": "~/.openclaw/agents/acp-dispatch/agent",
        "id": "acp-dispatch",
        "name": "ACP Dispatcher",
        "sandbox": {
          "mode": "off"
        },
        "tools": {
          "allow": [
            "session_status"
          ],
          "deny": [
            "*"
          ],
          "profile": "minimal"
        },
        "workspace": "~/.openclaw/workspace/acp-dispatch"
      }
    ]
  },
  // `/acp spawn` targets ACP harness ids; only the two worker harnesses are allowed.
  // OpenClaw 2026.8 names a spawned session `agent:<harness>:acp:<uuid>` and runs its turns as
  // that agent id, so each harness is named after the configured worker agent that owns it.
  "acp": {
    "allowedAgents": [
      "coder-acp-codex",
      "reviewer-acp-claude"
    ]
  },
  "bindings": [],
  "plugins": {
    "entries": {
      "acpx": {
        "config": {
          // Same adapter packages and ranges as acpx 0.21.1's built-in `codex` and `claude` harnesses.
          "agents": {
            "coder-acp-codex": {
              "args": [
                "-y",
                "@agentclientprotocol/codex-acp@^1.1.5"
              ],
              "command": "npx"
            },
            "reviewer-acp-claude": {
              "args": [
                "-y",
                "@agentclientprotocol/claude-agent-acp@^0.95.0"
              ],
              "command": "npx"
            }
          }
        }
      }
    }
  }
}
