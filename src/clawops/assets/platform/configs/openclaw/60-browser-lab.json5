{
  "browser": {
    "defaultProfile": "browserlab",
    "enabled": true,
    "evaluateEnabled": false,
    "profiles": {
      "browserlab": {
        "cdpUrl": "http://127.0.0.1:9222"
      }
    },
    "ssrfPolicy": {
      "allowedHostnames": [
        "github.com",
        "api.github.com",
        "docs.openclaw.ai"
      ],
      "dangerouslyAllowPrivateNetwork": false
    }
  },
  // OpenClaw 2026.8 ships the browser as a bundled plugin; doctor --fix enables it here.
  "plugins": {
    "entries": {
      "browser": {
        "enabled": true
      }
    }
  }
}
