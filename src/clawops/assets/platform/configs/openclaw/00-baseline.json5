{
  "agents": {
    // OpenClaw 2026.11 retired `heartbeat`: monitors are automation jobs, provisioned only by
    // `openclaw setup`, which StrongClaw never runs, so no periodic check exists.
    "defaults": {
      "imageMaxDimensionPx": 1200,
      "model": {
        "fallbacks": [
          "github-copilot/gpt-5.5",
          "zai/glm-5"
        ],
        "primary": "openai/gpt-5.4"
      },
      "models": {
        "github-copilot/gpt-5.5": {
          "alias": "copilot"
        },
        "openai/gpt-5.4": {
          "agentRuntime": {
            "id": "codex"
          },
          "alias": "gpt"
        },
        "zai/glm-5": {
          "alias": "glm5"
        }
      },
      "sandbox": {
        "mode": "all",
        "scope": "session",
        "workspaceAccess": "none"
      },
      "subagents": {
        "runTimeoutSeconds": 1800
      },
      "userTimezone": "__USER_TIMEZONE__",
      "workspace": "__ADMIN_WORKSPACE__"
    },
    "list": [
      {
        "agentDir": "~/.openclaw/agents/admin/agent",
        "default": true,
        "id": "admin",
        "name": "Admin",
        "sandbox": {
          "mode": "all",
          "scope": "agent",
          "workspaceAccess": "rw"
        },
        "tools": {
          "deny": [
            "gateway",
            "cron",
            "nodes",
            "canvas",
            "browser",
            "sessions_spawn"
          ],
          "profile": "minimal"
        },
        "workspace": "__ADMIN_WORKSPACE__"
      }
    ]
  },
  "browser": {
    "enabled": false,
    "evaluateEnabled": false,
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": false
    }
  },
  "channels": {
    "defaults": {
      "groupPolicy": "allowlist"
    },
    "telegram": {
      "dmPolicy": "pairing",
      "enabled": false,
      "groupPolicy": "disabled",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    },
    "whatsapp": {
      "dmPolicy": "pairing",
      "enabled": false,
      "groupPolicy": "disabled",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "gateway": {
    "auth": {
      "allowTailscale": false,
      "mode": "token",
      "token": {
        "id": "OPENCLAW_GATEWAY_TOKEN",
        "provider": "default",
        "source": "env"
      }
    },
    "bind": "loopback",
    "mode": "local",
    "port": 18789,
    "tailscale": {
      "mode": "off"
    }
  },
  "logging": {
    "consoleLevel": "info",
    "consoleStyle": "pretty",
    "level": "info"
  },
  "memory": {
    "citations": "auto"
  },
  "plugins": {
    "allow": [],
    "deny": [],
    "enabled": true,
    "entries": {},
    "slots": {
      "contextEngine": "legacy",
      "memory": "memory-core"
    }
  },
  "secrets": {
    "defaults": {
      "env": "default"
    },
    "providers": {
      "default": {
        "source": "env"
      }
    }
  },
  "skills": {
    // OpenClaw 2026.11 removed Skill Workshop proposals and their `approvalPolicy`.
    "workshop": {
      "autonomous": {
        "mode": "off"
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer",
    "maintenance": {
      "highWaterBytes": "400mb",
      "maxDiskBytes": "500mb",
      "maxEntries": 500,
      "mode": "warn",
      "pruneAfter": "30d",
      "resetArchiveRetention": "30d"
    },
    "reset": {
      "atHour": 4,
      "idleMinutes": 240,
      "mode": "daily"
    }
  },
  "tools": {
    "alsoAllow": [
      "read",
      "write",
      "edit"
    ],
    "deny": [
      "gateway",
      "cron",
      "nodes",
      "canvas",
      "browser",
      "apply_patch",
      "create_goal",
      "get_goal",
      "update_goal",
      "update_plan",
      "skill_workshop",
      "view_image",
      "image_generate",
      "music_generate",
      "video_generate",
      "agents_wait",
      "ask_user",
      "computer",
      "conversations_list",
      "conversations_send",
      "conversations_turn",
      "dashboard",
      "dismiss_task",
      "github_identity_status",
      "github_publish",
      "mobile_ui",
      "portal",
      "progress_card",
      "screen",
      "secrets",
      "sessions",
      "sessions_search",
      "show_widget",
      "suggest_task",
      "terminal"
    ],
    "elevated": {
      "enabled": false
    },
    "fs": {
      "workspaceOnly": true
    },
    "loopDetection": {
      "enabled": true
    },
    "profile": "minimal",
    "sessions": {
      "visibility": "self"
    }
  }
}
